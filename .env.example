# Identity of your mini app, issued by Telecom during onboarding.
APP_ID=34d5810c-7c36-11eb-82e7-f2189812cd57
# Shared secret. Read by server/ only; never ships to the browser.
APP_SECRET=my_secret_key
# Reject a nonce that was already presented. Needs shared storage across
# replicas, so it is off by default; turn on for money-related mini apps.
NONCE_CHECK=off
# Accepted skew of auth_date against server time, seconds, both directions.
AUTH_WINDOW=300
ADDR=:8080
